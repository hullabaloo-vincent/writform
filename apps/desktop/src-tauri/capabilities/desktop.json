{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only surfaces: dock badge, self-update, relaunch, window memory",
  "windows": ["main"],
  "platforms": ["macOS", "windows", "linux"],
  "permissions": [
    "core:window:allow-set-badge-count",
    "core:window:allow-destroy",
    "process:default",
    "updater:default",
    "window-state:default"
  ]
}
